<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View iap.account form -->
    <record id="view_iap_account_form" model="ir.ui.view">
        <field name="name">view.iap.account.form</field>
        <field name="model">iap.account</field>
        <field name="inherit_id" ref="iap.iap_account_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='account']" position="after">
                <group name="evolution_group" string="Evolution" invisible="provider != 'evolution'">
                    <field name="evolution_api_key" />
                    <field name="evolution_instance_id" />
                    <field name="evolution_api_url" />
                </group>
                <group name="whatsapp_group" string="Whatsapp" invisible="provider != 'whatsapp'">
                </group>
            </xpath>
        </field>
    </record>

</odoo>